[user]
	name = James Watts
	email = james@gocariq.com
[push]
	default = current
[core]
	editor = /opt/homebrew/bin/vim
[alias]
    c = checkout
    s = status
    b = branch
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[init]
	defaultBranch = main

[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
